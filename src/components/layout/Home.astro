---
---
<section id="home" class="px-4 sm:px-6 lg:px-8 pt-32 pb-24 bg-massage-primary">
    <div class="max-w-7xl mx-auto grid grid-cols-1 md:grid-cols-2 gap-8 items-stretch bg-surface rounded-2xl overflow-hidden">
        <!-- Linke Seite: Großes Bild -->
        <div class="relative min-h-100 md:min-h-full">
            <img
                    src="https://images.unsplash.com/photo-1544161515-4af6b1d462c2?q=80&w=1000&auto=format&fit=crop"
                    alt="Professionelle Masseurin in einer Wellness-Umgebung"
                    class="absolute inset-0 w-full h-full object-cover"
            />
        </div>

        <!-- Rechte Seite: Titel und Text -->
        <div class="p-8 md:p-12 lg:p-16 flex flex-col justify-center">
            <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold text-foreground mb-6">
                Willkommen bei CreaMassage
            </h1>
            <p class="text-lg md:text-xl text-muted-foreground leading-relaxed">
                Entspannen, regenerieren und neue Energie tanken – bei CreaMassage verbinden wir professionelle
                Massagekunst mit einem ganzheitlichen Ansatz für Körper und Wohlbefinden. Unsere Behandlungen helfen
                Ihnen dabei, Verspannungen zu lösen, Stress abzubauen und wieder in Ihre Balance zu finden.
            </p>
            <div class="mt-8">
                <a href="/#angebot"
                   class="py-3 px-8 inline-flex items-center gap-x-2 text-base font-medium rounded-2xl bg-massage-primary text-white hover:opacity-90 transition-all shadow-md focus:outline-hidden">
                    Unser Angebot entdecken
                </a>
            </div>
        </div>
    </div>
</section>